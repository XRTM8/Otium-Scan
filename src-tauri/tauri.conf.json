{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Otium Scan",
  "version": "0.2.8",
  "identifier": "com.otium.scan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Otium Scan",
        "url": "index.html",
        "width": 450,
        "height": 850,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' https://tauri.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://tauri.localhost https://api.github.com https://github.com https://objects.githubusercontent.com https://raw.githubusercontent.com",
        "font-src": "'self' data: https://tauri.localhost",
        "img-src": "'self' data: blob: https://tauri.localhost https://github.com https://avatars.githubusercontent.com",
        "media-src": "'self' blob: data: mediastream: https://tauri.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
